{
  "title": "HELIOS Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Requests",
      "targets": [{"expr": "helios_requests_total"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Tool Events",
      "targets": [{"expr": "helios_tool_events_total"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "gauge",
      "title": "Tool Failure Rate",
      "targets": [{"expr": "helios_tool_failure_rate"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    }
  ]
}
