# HELIOS local configuration
HELIOS_ENV=local
HELIOS_APP_VERSION=2.1.0
HELIOS_AI_PROVIDER=ollama,gemini
HELIOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HELIOS_MAX_CHAT_MESSAGE_CHARS=12000
HELIOS_MAX_ATTACHMENT_CHARS=12000
HELIOS_MAX_SOURCE_CONTENT_CHARS=12000
HELIOS_API_KEY=
HELIOS_AUTH_SECRET=
HELIOS_ADMIN_USERNAME=admin
HELIOS_ADMIN_PASSWORD=
HELIOS_TOKEN_TTL_MINUTES=480
HELIOS_RATE_LIMIT_PER_MINUTE=120
HELIOS_STORAGE_BACKEND=json
# Use sqlite for durable single-node deployment.
# HELIOS_STORAGE_BACKEND=sqlite
# Use postgres for production multi-worker deployment.
# HELIOS_STORAGE_BACKEND=postgres
# HELIOS_DATABASE_URL=postgresql://helios:password@localhost:5432/helios
HELIOS_POSTGRES_PASSWORD=helios-local-change-me
HELIOS_MAX_REALTIME_OFFER_BYTES=120000
HELIOS_WORKER_LEASE_SECONDS=90
HELIOS_BACKUP_KEEP=7
HELIOS_BACKUP_INTERVAL_SECONDS=86400

# Optional providers
HELIOS_OLLAMA_MODEL=qwen2.5:3b
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Frontend
NEXT_PUBLIC_HELIOS_API_URL=http://localhost:8000
NEXT_PUBLIC_HELIOS_WS_URL=
NEXT_PUBLIC_HELIOS_API_KEY=
